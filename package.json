{
  "name": "oficialia-digital-dsa",
  "version": "1.0.0-mvp",
  "private": true,
  "description": "Oficialia-Digital-DSA — middleware de ingesta, extracción IA y RPA (Hospital Civil de Guadalajara). Monorepo: backend (Fastify) + frontend (Svelte 5).",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "build:backend": "npm run build --workspace=backend",
    "typecheck:backend": "npm run typecheck --workspace=backend",
    "check:frontend": "npm run check --workspace=frontend",
    "typecheck": "npm run typecheck:backend && npm run check:frontend",
    "lint": "eslint backend/src frontend/src",
    "lint:fix": "eslint backend/src frontend/src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-eslint-parser": "^1.8.1",
    "typescript-eslint": "^8.69.0"
  }
}
