# Oficialia-Digital-DSA — backend/.env (chmod 600 en producción; nunca versionar el real)
PORT=3000
HOST=0.0.0.0
STORAGE_ROOT=storage
DATABASE_PATH=data/oficialia.db
PYTHON_BIN=python3
PDF_WORKER_SCRIPT_PATH=scripts/pdf_worker.py
GEMINI_API_KEY=
MAX_UPLOAD_BYTES=26214400
CORS_ORIGIN=
LOG_LEVEL=info

# --- Watchfolder (infrastructure/watcher/IncomingFolderWatcher.ts) --------
# Vigila STORAGE_ROOT/01_entrada/ por polling (no fs.watch: no es confiable sobre SMB) y
# dispara la ingesta SCANNER_ADF automáticamente para PDFs que el escáner departamental
# deposite ahí, sin que nadie llame a POST /documents/upload por él.
WATCHFOLDER_ENABLED=true
WATCHFOLDER_POLL_INTERVAL_MS=5000
# Tiempo (ms) sin cambios de tamaño/mtime antes de considerar un archivo "estable" y listo
# para leerlo — evita ingerir un PDF a medio escribir sobre el volumen SMB.
WATCHFOLDER_STABLE_FOR_MS=4000

# --- Google Sheets (infrastructure/sync/GoogleSheetsExternalSyncAdapter.ts) -
# Sin GOOGLE_SHEETS_SPREADSHEET_ID, el adaptador queda sin configurar y todo intento de
# sincronización falla de forma controlada (el pipeline principal no se bloquea — el
# documento se completa igual, solo queda marcado como pendiente de sincronizar).
# ID de la hoja: el segmento entre /d/ y /edit en la URL de Google Sheets.
GOOGLE_SHEETS_SPREADSHEET_ID=
# Nombre de la pestaña destino (default "Hoja1" si se omite).
GOOGLE_SHEETS_SHEET_NAME=Hoja1
# Credenciales de la Service Account — UNA de estas dos vías:
#   a) el JSON completo de la key, en una sola línea, aquí:
GOOGLE_SERVICE_ACCOUNT_JSON=
#   b) o, sin llenar la variable anterior, apuntar GOOGLE_APPLICATION_CREDENTIALS
#      (variable estándar de Application Default Credentials, fuera de este .env) a la
#      ruta del archivo .json de la Service Account en el servidor.
#
# La Service Account necesita permiso de Editor sobre la hoja de cálculo (compártela con
# su email tal como aparece en el JSON de credenciales, campo "client_email").

# --- RPA (infrastructure/rpa/) ---------------------------------------------
# 'stub' (default): PlaywrightRpaInjectionAdapter — no lanza navegador, health=false.
# 'playwright': PlaywrightRpaAdapter — automatización real contra op_cucs.fwx.
#   Requiere antes: npm run rpa:install-browsers (Chromium de Playwright).
RPA_MODE=stub
RPA_HEADLESS=true
# Base URL de la Intranet (si difiere del hardcode del adaptador)
INTRANET_BASE_URL=https://sii.hcg.gob.mx/intranet/op_cucs.fwx
# Credenciales HTTP Basic de la Intranet (si aplica; alias equivalentes soportados)
INTRANET_HTTP_USERNAME=
INTRANET_HTTP_PASSWORD=
RPA_INTRANET_USER=
RPA_INTRANET_PASSWORD=
# Claves (cve) institucionales precargadas en el formulario Webix op_ningr.fwx —
# ver docs/rpa/webix_dump_for_qwen.json. Si se omiten, el adaptador intenta resolver
# la oficialía tomando la primera opción del combo 'cve'.
RPA_OFICIALIA_CVE=
RPA_HCG_DEPENDENCIA_CVE=
RPA_SECCION_CVE=
