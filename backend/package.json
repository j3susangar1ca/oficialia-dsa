{
  "name": "oficialia-dsa-backend",
  "version": "1.0.0-mvp",
  "private": true,
  "description": "Oficialia-Digital-DSA — Middleware Fastify de ingesta, extracción IA y RPA (Hospital Civil de Guadalajara).",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/presentation/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/presentation/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "rpa:install-browsers": "playwright install chromium"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/websocket": "^11.0.1",
    "@google/genai": "^2.20.0",
    "better-sqlite3": "^11.5.0",
    "fastify": "^5.5.0",
    "fastify-type-provider-zod": "^7.0.0",
    "playwright": "^1.49.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.1",
    "@types/ws": "^8.5.13",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "optionalDependencies": {
    "@xenova/transformers": "^2.17.2"
  }
}
